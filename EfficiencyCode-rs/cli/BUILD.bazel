load("//:defs.bzl", "MACOS_WEBRTC_RUSTC_LINK_FLAGS", "EfficiencyCode_rust_crate")
load("//bazel/platforms:release_binaries.bzl", "multiplatform_binaries")
load("//bazel/rules:e2e_benchmark.bzl", "EfficiencyCode_e2e_benchmark")

EfficiencyCode_rust_crate(
    name = "cli",
    crate_name = "EfficiencyCode_cli",
    extra_binaries = [
        "//EfficiencyCode-rs/bwrap:bwrap",
    ],
    rustc_flags_extra = MACOS_WEBRTC_RUSTC_LINK_FLAGS,
    test_data_extra = glob(["src/**/snapshots/**"]),
)

multiplatform_binaries(
    name = "EfficiencyCode",
)

EfficiencyCode_e2e_benchmark(
    name = "EfficiencyCode-help",
    binaries = [":EfficiencyCode"],
)
